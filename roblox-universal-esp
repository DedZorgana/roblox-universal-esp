local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local function getHighlightColor(player)
    if player.Team then 
        return player.Team.TeamColor.Color 
    end
    return Color3.fromRGB(255, 255, 255)
end

local function setupCharacter(player, character)
    if player == LocalPlayer then return end
    
    local head = character:WaitForChild("Head", 5)
    local humanoid = character:WaitForChild("Humanoid", 5)
    if not head or not humanoid then return end

    -- 1. Подсветка персонажа (Highlight)
    local highlight = character:FindFirstChild("ESPHighlight")
    if not highlight then
        highlight = Instance.new("Highlight")
        highlight.Name = "ESPHighlight"
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.OutlineColor = Color3.new(1, 1, 1)
        highlight.Adornee = character
        highlight.Parent = character
    end
    highlight.FillColor = getHighlightColor(player)

    -- 2. Создание невидимого контейнера для текста
    local espGui = character:FindFirstChild("ESPGui")
    if not espGui then
        espGui = Instance.new("BillboardGui")
        espGui.Name = "ESPGui"
        espGui.Size = UDim2.new(0, 200, 0, 50)
        espGui.StudsOffset = Vector3.new(0, 3, 0) -- Высота над головой
        espGui.AlwaysOnTop = true
        espGui.Adornee = head
        espGui.Parent = character
        
        local textLabel = Instance.new("TextLabel")
        textLabel.Size = UDim2.new(1, 0, 1, 0)
        textLabel.BackgroundTransparency = 1 -- Полностью прозрачный фон
        textLabel.TextColor3 = Color3.new(1, 1, 1)
        textLabel.TextStrokeTransparency = 0 -- Черный контур для текста
        textLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
        textLabel.TextSize = 14
        textLabel.Font = Enum.Font.SourceSansBold
        textLabel.Parent = espGui
    end
    
    local label = espGui:FindFirstChildOfClass("TextLabel")

    -- 3. Обновление только текста (Ник, ХП, Дистанция)
    local connection
    connection = RunService.RenderStepped:Connect(function()
        if not character.Parent or not espGui.Parent then
            connection:Disconnect()
            return
        end
        
        if not LocalPlayer.Character then return end
        local localHead = LocalPlayer.Character:FindFirstChild("Head")
        if not localHead or not head then return end
        
        local distance = math.round((localHead.Position - head.Position).Magnitude)
        local health = math.round(humanoid.Health)
        
        if label then
            -- Вывод чистого текста в формате: Ник [100 HP] (50m)
            label.Text = string.format("%s [%d HP]\n(%dm)", player.Name, health, distance)
            label.TextColor3 = getHighlightColor(player) -- Цвет букв под цвет команды
        end
    end)

    player:GetPropertyChangedSignal("Team"):Connect(function()
        if highlight.Parent then 
            highlight.FillColor = getHighlightColor(player) 
        end
    end)
end

local function setupPlayer(player)
    if player == LocalPlayer then return end
    if player.Character then 
        setupCharacter(player, player.Character) 
    end
    player.CharacterAdded:Connect(function(character)
        setupCharacter(player, character)
    end)
end

for _, player in ipairs(Players:GetPlayers()) do
    setupPlayer(player)
end
Players.PlayerAdded:Connect(setupPlayer)
